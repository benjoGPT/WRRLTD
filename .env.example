# Copy this file to .env.local for local development, and add the same
# variables in your hosting dashboard (Vercel: Project > Settings >
# Environment Variables). Never commit the real values.

# API key from https://resend.com/api-keys
RESEND_API_KEY=

# Where form submissions are emailed. Separate several with commas.
# Until a domain is verified in Resend, this must be the email address
# you signed up to Resend with.
CONTACT_TO_EMAIL=

# Who the emails come from. Leave blank to use Resend's test sender
# (onboarding@resend.dev). Once wrightpointrecruitment.co.uk is verified
# in Resend, set it to something like:
# CONTACT_FROM_EMAIL="Wright Point website <website@wrightpointrecruitment.co.uk>"
CONTACT_FROM_EMAIL=
